# Copy to /etc/mcv-orders.env on the VM; never into the public web root.
SITE_ORIGIN=https://macherevictoria.artalbom-graf.com
PORT=3100
SMTP_HOST=smtp.example.com
# Use 465 with SMTP_SECURE=true for implicit TLS, or 587 with SMTP_SECURE=false
# for mandatory STARTTLS. Unencrypted SMTP is not supported.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=orders@example.com
SMTP_PASS=replace-outside-the-repository
SMTP_FROM=orders@example.com
# Enable only behind the supplied local nginx proxy, which overwrites this header.
TRUST_PROXY=true
